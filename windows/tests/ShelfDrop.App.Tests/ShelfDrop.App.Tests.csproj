<Project Sdk="Microsoft.NET.Sdk">

  <!-- These tests need Windows: they open real windows, read the registry and listen to the mouse. They run in the
       automated build on a Windows machine. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>false</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShelfDrop.App\ShelfDrop.App.csproj" />
    <ProjectReference Include="..\..\src\ShelfDrop.Core\ShelfDrop.Core.csproj" />
    <!-- For its fakes (a temp folder, a fake screen list...), which both sets of tests use. -->
    <ProjectReference Include="..\ShelfDrop.Core.Tests\ShelfDrop.Core.Tests.csproj" />
  </ItemGroup>

</Project>
